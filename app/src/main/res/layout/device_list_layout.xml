<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginBottom="8dp">
        <Button android:id="@+id/refreshButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="🔄 Scan" android:background="#4CAF50" android:textColor="#FFFFFF"
            android:layout_marginEnd="4dp" android:textSize="12sp"/>
        <Button android:id="@+id/diagnoseButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="🔧 Diagnose" android:background="#FF9800" android:textColor="#FFFFFF"
            android:layout_marginStart="4dp" android:textSize="12sp"/>
    </LinearLayout>
    <ListView android:id="@+id/listView" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:background="#FAFAFA"
        android:divider="#E0E0E0" android:dividerHeight="1dp"
        android:choiceMode="singleChoice" android:listSelector="#E3F2FD" android:padding="4dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="#E8F5E8" android:orientation="vertical"
        android:padding="8dp" android:layout_marginTop="4dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="💡 Tip: Select a device and tap Diagnose for detailed analysis"
            android:textColor="#2E7D32" android:textSize="11sp" android:drawablePadding="4dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🔒 All scans are logged securely for professional use"
            android:textColor="#2E7D32" android:textSize="11sp" android:layout_marginTop="2dp"/>
    </LinearLayout>
</LinearLayout>
